# Paramètres de la simulation Azure (UC-07). MODÈLE SANS SECRET : copier en parametres.env (non versionné, .gitignore)
# et remplacer les valeurs entre <>. Ce fichier ne contient et ne doit contenir aucune clé, aucun jeton, aucun mot de passe.
ABONNEMENT="<id-ou-nom-de-l-abonnement-autorise>"
REGION="francecentral"
RG="rg-retail-intelligence-dev"
COMPTE="stretailintel<suffixe-unique>"     # 3-24 caractères, minuscules et chiffres
CONTENEUR="retail-intelligence"
BUDGET_EUR="10"
DEBUT_MOIS="<AAAA-MM-01>"
FIN_BUDGET="<AAAA-MM-JJ>"
# Identifiants d'objet (object id) des groupes Microsoft Entra ID : ce ne sont pas des secrets, mais ils restent locaux
GRP_ADMINS="<object-id-grp-retail-admins>"
GRP_INGESTION="<object-id-identite-managee-adf>"
GRP_DATAENG="<object-id-grp-retail-dataeng>"
GRP_ANALYSTES="<object-id-grp-retail-analystes>"
